{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/immigrant_be/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/immigrant_be/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/immigrant_be",
  "projects": {
    "config": {
      "type": "library",
      "root": "libs/config",
      "entryFile": "index",
      "sourceRoot": "libs/config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/config/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "immigrant_be": {
      "type": "application",
      "root": "apps/immigrant_be",
      "entryFile": "main",
      "sourceRoot": "apps/immigrant_be/src",
      "compilerOptions": {
        "tsConfigPath": "apps/immigrant_be/tsconfig.app.json"
      }
    },
    "webhooks": {
      "type": "application",
      "root": "apps/webhooks",
      "entryFile": "main",
      "sourceRoot": "apps/webhooks/src",
      "compilerOptions": {
        "tsConfigPath": "apps/webhooks/tsconfig.app.json"
      }
    }
  }
}
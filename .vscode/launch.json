{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug NestJS App",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v22.20.0/bin/node",
      "runtimeArgs": [
        "--inspect-brk=9229",
        "-r",
        "ts-node/register",
        "-r",
        "tsconfig-paths/register"
      ],
      "args": ["${workspaceFolder}/apps/immigrant_be/src/main.ts"],
      "restart": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development",
        "TS_NODE_PROJECT": "${workspaceFolder}/apps/immigrant_be/tsconfig.app.json",
        "TS_NODE_TRANSPILE_ONLY": "true",
        "TS_NODE_FILES": "true",
        "PATH": "${env:HOME}/.nvm/versions/node/v22.20.0/bin:${env:PATH}"
      },
      "outputCapture": "std"
    }
  ]
}

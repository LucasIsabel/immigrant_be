// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  sessions      Sessions[]
  accounts      Accounts[]
  plans         Plans[]
  events Events[]

  @@unique([email])
  @@map("users")
}

model Sessions {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @db.Uuid @map("user_id")
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("sessions")
}

model Accounts {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @db.Uuid @map("user_id")
  user                  Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("accounts")
}

model Verifications {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("verifications")
}

model CountryDescription {
  id          String   @id @default(uuid()) @db.Uuid
  language    String
  description String
  country     Country  @relation(fields: [country_id], references: [id])
  country_id  String   @db.Uuid @map("country_id")

  @@unique([country_id, language])
  @@map("country_descriptions")
}

model ImmigrationVisaType {
  id          String   @id @default(uuid()) @db.Uuid
  category    String
  description String
  source      String
  country     Country  @relation(fields: [country_id], references: [id], onDelete: Cascade)
  country_id  String   @db.Uuid @map("country_id")
  steps Json @map("steps") @default("[]")
  plans Plans[]

  @@index([country_id])
  @@map("immigration_visa_types")
}

model Country {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String   @unique
  flag                  String
  region                String
  difficulty            String
  difficulty_score      Int      @map("difficulty_score")
  descriptions          CountryDescription[]
  immigration_visa_types ImmigrationVisaType[]
  visa_options          String[] @map("visa_options")
  processing_time       String   @map("processing_time")
  investment_required   String   @map("investment_required")
  language_requirement  String   @map("language_requirement")
  job_market            String   @map("job_market")
  benefits              String[]
  challenges            String[]
  popular_cities        String[] @map("popular_cities")
  created_at            DateTime @default(now()) @map("created_at")
  updated_at            DateTime @updatedAt @map("updated_at")
  background_image      String   @map("background_image")
  plans                 Plans[]
  visa_type_recommendations VisaTypeRecommendations[]

  @@map("countries")
}

model Suggestions {
  id String @id @default(uuid()) @db.Uuid
  embeddings Unsupported("vector")? @map("embeddings")
  parameters Json @map("parameters")
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")
  plans Plans[]
  suggestion_languages Suggestion_languages[]
  
  @@map("suggestions")
}

model Suggestion_languages {
  id String @id @default(uuid()) @db.Uuid
  language String
  content Json @map("content")
  suggestion_id String @db.Uuid @map("suggestion_id")
  suggestion Suggestions @relation(fields: [suggestion_id], references: [id], onDelete: Cascade)
  
  @@unique([suggestion_id, language])
  @@map("suggestion_languages")
}

model Plans {
  id String @id @default(uuid()) @db.Uuid
  user_id String @db.Uuid @map("user_id")
  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  suggestion_id String? @db.Uuid @map("suggestion_id")
  suggestion Suggestions? @relation(fields: [suggestion_id], references: [id], onDelete: SetNull)
  country_id String? @db.Uuid @map("country_id")
  country Country? @relation(fields: [country_id], references: [id], onDelete: SetNull)
  steps Json @map("steps") @default("[]")
  steps_completed Json @map("steps_completed") @default("[]")
  steps_remaining Json @map("steps_remaining") @default("[]")
  documents Json @map("documents") @default("[]")
  selected_suggestion Json? @map("selected_suggestion")
  status String @default("draft") @map("status")
  name String? @map("name")
  notes String? @map("notes")
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")
  progress Float @default(0) @map("progress")
  description String? @map("description")
  selected_visa_type_id String? @db.Uuid @map("selected_visa_type_id")
  selected_visa_type ImmigrationVisaType? @relation(fields: [selected_visa_type_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
  @@index([country_id])
  @@map("plans")
}

enum NotificationStatus {
  pending
  delivered
  failed
}

model Events {
  id            String               @id @default(uuid())
  user_id String @db.Uuid @map("user_id")
  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type          String
  title         String?
  message       String?
  payload       Json? 
  status        NotificationStatus   @default(pending)
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt

  @@index([user_id])
  @@index([status])
  @@index([created_at])
}

model VisaTypeRecommendations {
  id                    String   @id @default(uuid()) @db.Uuid
  country_id            String   @db.Uuid @map("country_id")
  country                Country  @relation(fields: [country_id], references: [id], onDelete: Cascade)
  gemini_response       Json     @map("gemini_response")
  embeddings            Unsupported("vector")? @map("embeddings")
  parameters            Json     @map("parameters")
  user_details          Json     @map("user_details")
  created_at            DateTime @default(now()) @map("created_at")
  updated_at            DateTime @updatedAt @map("updated_at")

  @@index([country_id])
  @@map("visa_type_recommendations")
}
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  sessions      Sessions[]
  accounts      Accounts[]

  @@unique([email])
  @@map("users")
}

model Sessions {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @db.Uuid @map("user_id")
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("sessions")
}

model Accounts {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @db.Uuid @map("user_id")
  user                  Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("accounts")
}

model Verifications {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("verifications")
}

model CountryDescription {
  id          String   @id @default(uuid()) @db.Uuid
  language    String
  description String
  country     Country  @relation(fields: [country_id], references: [id])
  country_id  String   @db.Uuid @map("country_id")

  @@unique([country_id, language])
  @@map("country_descriptions")
}

model Country {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String   @unique
  flag                  String
  region                String
  difficulty            String
  difficulty_score      Int      @map("difficulty_score")
  descriptions          CountryDescription[]
  visa_options          String[] @map("visa_options")
  processing_time       String   @map("processing_time")
  investment_required   String   @map("investment_required")
  language_requirement  String   @map("language_requirement")
  job_market            String   @map("job_market")
  benefits              String[]
  challenges            String[]
  popular_cities        String[] @map("popular_cities")
  created_at            DateTime @default(now()) @map("created_at")
  updated_at            DateTime @updatedAt @map("updated_at")
  background_image      String   @map("background_image")

  @@map("countries")
}

model Suggestions {
  id String @id @default(uuid()) @db.Uuid
  suggestions_answer Json @map("suggestions_answer")
  embeddings Unsupported("vector")?

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")
  @@map("suggestions")
}
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String
  emailVerified Boolean   @default(false) @map("email_verified")
  image                     String?
  bio                       String?  @db.Text
  emailNotificationsEnabled Boolean  @default(true) @map("email_notifications_enabled")
  isActive      Boolean   @default(true) @map("is_active")
  banned        Boolean   @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  sessions        Sessions[]
  accounts        Accounts[]
  plans           Plans[]
  events          Events[]
  userRoles       UserRoles[]
  blog_posts         BlogPost[]
  blog_post_likes    BlogPostLike[]
  aiGeneratedImages  AiGeneratedImage[]
  professionalProfile UserProfessionalProfile?
  businesses          Business[]

  @@unique([email])
  @@map("users")
}

model Roles {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  userRoles   UserRoles[]

  @@map("roles")
}

model UserRoles {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String   @db.Uuid @map("role_id")
  role       Roles    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Sessions {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @db.Uuid @map("user_id")
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     String   @default("[]")

  @@unique([token])
  @@map("sessions")
}

model Accounts {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @db.Uuid @map("user_id")
  user                  Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("accounts")
}

model Verifications {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("verifications")
}

model CountryDescription {
  id          String   @id @default(uuid()) @db.Uuid
  language    String
  description String
  country     Country  @relation(fields: [country_id], references: [id])
  country_id  String   @db.Uuid @map("country_id")

  @@unique([country_id, language])
  @@map("country_descriptions")
}

model ImmigrationVisaType {
  id          String   @id @default(uuid()) @db.Uuid
  category    String
  description String
  source      String
  country     Country  @relation(fields: [country_id], references: [id], onDelete: Cascade)
  country_id  String   @db.Uuid @map("country_id")
  plans Plans[]
  visa_steps VisaSteps[]

  @@index([country_id])
  @@map("immigration_visa_types")
}

model Country {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String   @unique
  flag                  String
  region                String
  difficulty            String
  difficulty_score      Int      @map("difficulty_score")
  descriptions          CountryDescription[]
  immigration_visa_types ImmigrationVisaType[]
  visa_options          String[] @map("visa_options")
  processing_time       String   @map("processing_time")
  investment_required   String   @map("investment_required")
  language_requirement  String   @map("language_requirement")
  job_market            String   @map("job_market")
  benefits              String[]
  challenges            String[]
  popular_cities        String[] @map("popular_cities")
  created_at            DateTime @default(now()) @map("created_at")
  updated_at            DateTime @updatedAt @map("updated_at")
  background_image      String   @map("background_image")
  plans                 Plans[]
  visa_type_recommendations VisaTypeRecommendations[]
  blog_posts            BlogPost[]
  ai_blog_cron_jobs     AiBlogCronJob[]

  @@map("countries")
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id               String         @id @default(uuid()) @db.Uuid
  title            String
  slug             String         @unique
  excerpt          String
  content          String         @db.Text
  cover_image_url  String?        @map("cover_image_url")
  status           BlogPostStatus @default(DRAFT)
  reading_time_min Int?           @map("reading_time_min")
  views_count      Int            @default(0) @map("views_count")
  published_at     DateTime?      @map("published_at")
  created_at       DateTime       @default(now()) @map("created_at")
  updated_at       DateTime       @updatedAt @map("updated_at")

  author_id           String       @db.Uuid @map("author_id")
  author              Users        @relation(fields: [author_id], references: [id])

  category_id         String       @db.Uuid @map("category_id")
  category            BlogCategory @relation(fields: [category_id], references: [id])

  featured_country_id String?      @db.Uuid @map("featured_country_id")
  featured_country    Country?     @relation(fields: [featured_country_id], references: [id])

  display_author_id String?      @db.Uuid @map("display_author_id")
  display_author    BlogAuthor?  @relation(fields: [display_author_id], references: [id], onDelete: SetNull)

  tags BlogPostTag[]

  is_ai_generated          Boolean @default(false) @map("is_ai_generated")
  refine_needs_manual_fix  Boolean @default(false) @map("refine_needs_manual_fix")
  original_locale          String  @default("en") @map("original_locale")
  translations     BlogPostTranslation[]
  likes            BlogPostLike[]

  @@index([status, published_at])
  @@index([slug])
  @@index([category_id])
  @@index([author_id])
  @@index([display_author_id])
  @@map("blog_posts")
}

model BlogPostTranslation {
  id            String   @id @default(uuid()) @db.Uuid
  post_id       String   @db.Uuid
  post          BlogPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  locale        String
  title         String
  excerpt       String
  content       String   @db.Text
  translated_by String   @default("AI")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([post_id, locale])
  @@index([post_id])
  @@map("blog_post_translations")
}

model BlogPostLike {
  id         String   @id @default(uuid()) @db.Uuid
  post_id    String   @db.Uuid @map("post_id")
  user_id    String   @db.Uuid @map("user_id")
  created_at DateTime @default(now()) @map("created_at")

  post BlogPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id])
  @@index([post_id])
  @@index([user_id])
  @@map("blog_post_likes")
}

model BlogAuthor {
  id         String     @id @default(uuid()) @db.Uuid
  name       String
  bio        String?    @db.Text
  avatar_url String?    @map("avatar_url")
  website    String?
  twitter    String?
  linkedin   String?
  created_at DateTime   @default(now()) @map("created_at")
  updated_at DateTime   @updatedAt @map("updated_at")
  posts            BlogPost[]
  ai_blog_cron_jobs AiBlogCronJob[]

  @@map("blog_authors")
}

model BlogCategory {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @unique
  slug       String     @unique
  created_at DateTime   @default(now()) @map("created_at")
  updated_at DateTime   @updatedAt @map("updated_at")
  posts      BlogPost[]

  @@map("blog_categories")
}

model BlogTag {
  id         String        @id @default(uuid()) @db.Uuid
  name       String        @unique
  slug       String        @unique
  created_at DateTime      @default(now()) @map("created_at")
  updated_at DateTime      @updatedAt @map("updated_at")
  posts      BlogPostTag[]

  @@map("blog_tags")
}

model BlogPostTag {
  post_id String   @db.Uuid @map("post_id")
  tag_id  String   @db.Uuid @map("tag_id")
  post    BlogPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  tag     BlogTag  @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([post_id, tag_id])
  @@map("blog_post_tags")
}

model Suggestions {
  id String @id @default(uuid()) @db.Uuid
  embeddings Unsupported("vector")? @map("embeddings")
  parameters Json @map("parameters")
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")
  plans Plans[]
  suggestion_languages Suggestion_languages[]
  
  @@map("suggestions")
}

model Suggestion_languages {
  id String @id @default(uuid()) @db.Uuid
  language String
  content Json @map("content")
  suggestion_id String @db.Uuid @map("suggestion_id")
  suggestion Suggestions @relation(fields: [suggestion_id], references: [id], onDelete: Cascade)
  
  @@unique([suggestion_id, language])
  @@map("suggestion_languages")
}

model Plans {
  id String @id @default(uuid()) @db.Uuid
  user_id String @db.Uuid @map("user_id")
  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  suggestion_id String? @db.Uuid @map("suggestion_id")
  suggestion Suggestions? @relation(fields: [suggestion_id], references: [id], onDelete: SetNull)
  country_id String? @db.Uuid @map("country_id")
  country Country? @relation(fields: [country_id], references: [id], onDelete: SetNull)
  steps Json? @map("steps")
  steps_completed Json? @map("steps_completed")
  steps_remaining Json? @map("steps_remaining")
  documents Json @map("documents") @default("[]")
  selected_suggestion Json? @map("selected_suggestion")
  status String @default("draft") @map("status")
  name String? @map("name")
  notes String? @map("notes")
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")
  progress Float @default(0) @map("progress")
  description String? @map("description")
  selected_visa_type_id String? @db.Uuid @map("selected_visa_type_id")
  selected_visa_type ImmigrationVisaType? @relation(fields: [selected_visa_type_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
  @@index([country_id])
  @@map("plans")
}

enum NotificationStatus {
  pending
  delivered
  failed
}

model Events {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid @map("user_id")
  user      Users              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String?
  message   String?
  payload   Json?
  status    NotificationStatus @default(pending)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("events")
}

model VisaTypeRecommendations {
  id                    String   @id @default(uuid()) @db.Uuid
  country_id            String   @db.Uuid @map("country_id")
  country                Country  @relation(fields: [country_id], references: [id], onDelete: Cascade)
  gemini_response       Json     @map("gemini_response")
  embeddings            Unsupported("vector")? @map("embeddings")
  parameters            Json     @map("parameters")
  created_at            DateTime @default(now()) @map("created_at")
  updated_at            DateTime @updatedAt @map("updated_at")
  language              String 

  @@index([country_id])
  @@map("visa_type_recommendations")
}

model VisaSteps {
  id String @id @default(uuid()) @db.Uuid
  language String
  steps Json @default("[]")
  visa_type_id String @db.Uuid @map("visa_type_id")
  visa_type ImmigrationVisaType @relation(fields: [visa_type_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@map("visa_steps")
}

model AiBlogCronJob {
  id                  String    @id @default(uuid()) @db.Uuid
  country_id          String    @db.Uuid @map("country_id")
  country             Country   @relation(fields: [country_id], references: [id], onDelete: Cascade)
  category_id         String    @db.Uuid @map("category_id")
  cron_expr           String    @map("cron_expr")
  is_active           Boolean   @default(true) @map("is_active")
  last_run_at         DateTime? @map("last_run_at")
  bullmq_job_id       String?   @map("bullmq_job_id")
  author_id           String?   @db.Uuid @map("author_id")
  display_author_id   String?   @db.Uuid @map("display_author_id")
  display_author      BlogAuthor? @relation(fields: [display_author_id], references: [id], onDelete: SetNull)
  complexity          String    @default("SIMPLE") @map("complexity")
  political_tone      String    @default("NEUTRAL") @map("political_tone")
  custom_instructions String?   @db.Text @map("custom_instructions")
  created_at          DateTime  @default(now()) @map("created_at")
  updated_at          DateTime  @updatedAt @map("updated_at")

  @@index([country_id])
  @@map("ai_blog_cron_jobs")
}

model UserProfessionalProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid @map("user_id")
  user              Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle          String?  @map("job_title")
  company           String?
  linkedinUrl       String?  @map("linkedin_url")
  githubUrl         String?  @map("github_url")
  websiteUrl        String?  @map("website_url")
  bio               String?  @db.Text
  skills            String[]
  yearsOfExperience Int?     @map("years_of_experience")
  location          String?
  isPublic          Boolean  @default(true) @map("is_public")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("user_professional_profiles")
}

model AiGeneratedImage {
  id           String   @id @default(uuid()) @db.Uuid
  prompt       String   @db.Text
  folder       String
  key          String?
  url          String?
  mimeType     String?  @map("mime_type")
  isPublic     Boolean  @default(true) @map("is_public")
  status       String   @default("pending")
  errorMessage String?  @map("error_message") @db.Text
  userId       String   @map("user_id") @db.Uuid
  user         Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("ai_generated_images")
}

enum BusinessType {
  RESTAURANT
  LEGAL
  TOUR_GUIDE
  GENERAL
}

model Business {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid @map("user_id")
  user         Users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessType BusinessType @map("business_type")
  name         String       @db.VarChar(100)
  description  String?      @db.Text
  address      String?      @db.VarChar(200)
  city         String       @db.VarChar(100)
  country      String?      @db.VarChar(100)
  state        String?      @db.VarChar(120)
  lat          Float?
  lng          Float?
  phone        String?      @db.VarChar(20)
  email        String?      @db.VarChar(100)
  website      String?      @db.VarChar(200)
  photos       String[]
  typeData     Json?        @map("type_data")
  isPublic     Boolean      @default(false) @map("is_public")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([userId])
  @@index([businessType, isPublic])
  @@index([city, isPublic])
  @@map("businesses")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id                              String                   @id @default(uuid()) @db.Uuid
  name                            String
  email                           String
  emailVerified                   Boolean                  @default(false) @map("email_verified")
  image                           String?
  bio                             String?                  @db.Text
  emailNotificationsEnabled       Boolean                  @default(true) @map("email_notifications_enabled")
  isActive                        Boolean                  @default(true) @map("is_active")
  banned                          Boolean                  @default(false)
  banReason                       String?                  @map("ban_reason")
  banExpires                      DateTime?                @map("ban_expires")
  createdAt                       DateTime                 @default(now()) @map("created_at")
  updatedAt                       DateTime                 @default(now()) @updatedAt @map("updated_at")
  sessions                        Sessions[]
  accounts                        Accounts[]
  plans                           Plans[]
  events                          Events[]
  userRoles                       UserRoles[]
  blog_posts                      BlogPost[]
  blog_post_likes                 BlogPostLike[]
  aiGeneratedImages               AiGeneratedImage[]
  professionalProfile             UserProfessionalProfile?
  businesses                      Business[]
  approvedBusinessPages           BusinessPage[]           @relation("ApprovedPages")
  rejectedBusinessPages           BusinessPage[]           @relation("RejectedPages")
  businessPageReviews             BusinessPageReview[]     @relation("ReviewedPages")
  publisherQualificationOverrides PublisherQualification[] @relation("PublisherOverrides")
  tourGuideReviews                TourGuideReview[]

  @@unique([email])
  @@map("users")
}

model Roles {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  userRoles   UserRoles[]

  @@map("roles")
}

model UserRoles {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String   @map("role_id") @db.Uuid
  role       Roles    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Sessions {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     String   @default("[]")

  @@unique([token])
  @@map("sessions")
}

model Accounts {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("accounts")
}

model Verifications {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("verifications")
}

/// User-facing country copy, one row per language.
/// Closed vocabularies (`difficulty`, `job_market`) and proper nouns
/// (`visa_options`, `popular_cities`) stay on Country and are translated
/// by the frontend instead.
model CountryTranslation {
  id                   String   @id @default(uuid()) @db.Uuid
  language             String
  description          String
  benefits             String[]
  challenges           String[]
  processing_time      String   @map("processing_time")
  investment_required  String   @map("investment_required")
  language_requirement String   @map("language_requirement")
  country              Country  @relation(fields: [country_id], references: [id], onDelete: Cascade)
  country_id           String   @map("country_id") @db.Uuid

  @@unique([country_id, language])
  @@map("country_translations")
}

model ImmigrationVisaType {
  id          String      @id @default(uuid()) @db.Uuid
  category    String
  description String
  source      String
  country     Country     @relation(fields: [country_id], references: [id], onDelete: Cascade)
  country_id  String      @map("country_id") @db.Uuid
  plans       Plans[]
  visa_steps  VisaSteps[]

  @@index([country_id])
  @@map("immigration_visa_types")
}

model Country {
  id                        String                    @id @default(uuid()) @db.Uuid
  name                      String                    @unique
  flag                      String
  region                    String
  difficulty                String
  difficulty_score          Int                       @map("difficulty_score")
  translations              CountryTranslation[]
  immigration_visa_types    ImmigrationVisaType[]
  visa_options              String[]                  @map("visa_options")
  job_market                String                    @map("job_market")
  popular_cities            String[]                  @map("popular_cities")
  created_at                DateTime                  @default(now()) @map("created_at")
  updated_at                DateTime                  @updatedAt @map("updated_at")
  background_image          String                    @map("background_image")
  plans                     Plans[]
  visa_type_recommendations VisaTypeRecommendations[]
  blog_posts                BlogPost[]
  ai_blog_cron_jobs         AiBlogCronJob[]
  places                    Place[]

  @@map("countries")
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Onde um post gerado por IA está na cadeia texto → tradução → imagem.
///
/// Não há `GENERATING` nem `FAILED_GENERATION`: a linha do post só nasce depois
/// que o texto ficou pronto, e uma geração que falha não chega a criar post
/// nenhum. Falha de escrita é visível na fila, não aqui — inventar um estado que
/// nenhuma linha pode ter só criaria código morto.
///
/// `READY` é o default para que post escrito por gente, e todos os que já
/// existiam, nasçam corretos sem backfill.
enum BlogPipelineStatus {
  TRANSLATING
  GENERATING_IMAGE
  READY
  FAILED_TRANSLATION
  FAILED_IMAGE
}

model BlogPost {
  id               String         @id @default(uuid()) @db.Uuid
  title            String
  slug             String         @unique
  excerpt          String
  content          String         @db.Text
  cover_image_url  String?        @map("cover_image_url")
  status           BlogPostStatus @default(DRAFT)
  reading_time_min Int?           @map("reading_time_min")
  views_count      Int            @default(0) @map("views_count")
  published_at     DateTime?      @map("published_at")
  created_at       DateTime       @default(now()) @map("created_at")
  updated_at       DateTime       @updatedAt @map("updated_at")

  author_id String @map("author_id") @db.Uuid
  author    Users  @relation(fields: [author_id], references: [id])

  category_id String       @map("category_id") @db.Uuid
  category    BlogCategory @relation(fields: [category_id], references: [id])

  featured_country_id String?  @map("featured_country_id") @db.Uuid
  featured_country    Country? @relation(fields: [featured_country_id], references: [id])

  display_author_id String?     @map("display_author_id") @db.Uuid
  display_author    BlogAuthor? @relation(fields: [display_author_id], references: [id], onDelete: SetNull)

  tags BlogPostTag[]

  is_ai_generated         Boolean               @default(false) @map("is_ai_generated")
  refine_needs_manual_fix Boolean               @default(false) @map("refine_needs_manual_fix")
  original_locale         String                @default("en") @map("original_locale")
  /// Em que etapa da cadeia o post está. Antes disto o único sinal era
  /// `cover_image_url` nulo, que não distingue "ainda vem" de "falhou".
  pipeline_status         BlogPipelineStatus    @default(READY) @map("pipeline_status")
  /// O que deu errado na etapa que falhou, para a tela não obrigar quem lê a
  /// abrir o log. Nulo quando não houve falha.
  pipeline_error          Json?                 @map("pipeline_error")
  /// Sobre o que o admin pediu que este post fosse. Alimenta a busca nas
  /// notícias e fica registrado — `custom_instructions` é texto livre para o
  /// modelo, isto é dado.
  source_topic            String?               @map("source_topic")
  /// Qual modelo escreveu o post e quanto custou. Nulos nos posts anteriores ao
  /// roteador e nos escritos por gente. `generated_by_model` é o modelo que de
  /// fato respondeu — pode ser um elo de fallback, e é isso que o revisor
  /// precisa saber antes de aprovar.
  generated_by_model      String?               @map("generated_by_model")
  generation_cost_usd     Decimal?              @map("generation_cost_usd") @db.Decimal(10, 6)
  /// Colunista de IA que escreveu o post, quando a geração passou por persona.
  persona_id              String?               @map("persona_id") @db.Uuid
  persona                 BlogPersona?          @relation(fields: [persona_id], references: [id], onDelete: SetNull)
  /// Liga os dois lados de um debate. Nulo nos posts que não fazem parte de um par.
  debate_group_id         String?               @map("debate_group_id") @db.Uuid
  /// Resultado da auto-moderação. Draft flagado não é bloqueado — só destacado na fila.
  moderation_flag         Json?                 @map("moderation_flag")
  translations            BlogPostTranslation[]
  likes                   BlogPostLike[]

  @@index([status, published_at])
  @@index([pipeline_status])
  @@index([slug])
  @@index([category_id])
  @@index([author_id])
  @@index([display_author_id])
  @@index([persona_id])
  @@index([debate_group_id])
  @@map("blog_posts")
}

model BlogPostTranslation {
  id                  String   @id @default(uuid()) @db.Uuid
  post_id             String   @db.Uuid
  post                BlogPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  locale              String
  title               String
  excerpt             String
  content             String   @db.Text
  translated_by       String   @default("AI")
  /// Complementa `translated_by`: aquele diz se foi IA ou gente, este diz qual
  /// modelo. Nulo nas traduções anteriores ao roteador.
  translated_by_model String?  @map("translated_by_model")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@unique([post_id, locale])
  @@index([post_id])
  @@map("blog_post_translations")
}

model BlogPostLike {
  id         String   @id @default(uuid()) @db.Uuid
  post_id    String   @map("post_id") @db.Uuid
  user_id    String   @map("user_id") @db.Uuid
  created_at DateTime @default(now()) @map("created_at")

  post BlogPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id])
  @@index([post_id])
  @@index([user_id])
  @@map("blog_post_likes")
}

model BlogAuthor {
  id                String          @id @default(uuid()) @db.Uuid
  name              String
  bio               String?         @db.Text
  avatar_url        String?         @map("avatar_url")
  website           String?
  twitter           String?
  linkedin          String?
  created_at        DateTime        @default(now()) @map("created_at")
  updated_at        DateTime        @updatedAt @map("updated_at")
  posts             BlogPost[]
  ai_blog_cron_jobs AiBlogCronJob[]
  persona           BlogPersona?

  @@map("blog_authors")
}

enum BlogPersonaTheme {
  IMMIGRATION
  TOURISM
}

/// Colunista editorial gerado por IA. O tom mora aqui, não no dropdown de
/// `PoliticalTone` — aquele continua só para geração sem persona.
///
/// Os guardrails de conteúdo **não** ficam nesta tabela: vivem em
/// `libs/ai/src/prompts/persona-guardrails.ts`, para um admin não conseguir
/// apagá-los editando o prompt.
model BlogPersona {
  id                String           @id @default(uuid()) @db.Uuid
  slug              String           @unique
  name              String
  theme             BlogPersonaTheme
  editorial_stance  String           @map("editorial_stance")
  persona_prompt    String           @map("persona_prompt") @db.Text
  style_guidelines  String           @map("style_guidelines") @db.Text
  preferred_model   String?          @map("preferred_model")
  blog_author_id    String           @unique @map("blog_author_id") @db.Uuid
  blog_author       BlogAuthor       @relation(fields: [blog_author_id], references: [id], onDelete: Restrict)
  is_active         Boolean          @default(true) @map("is_active")
  created_at        DateTime         @default(now()) @map("created_at")
  updated_at        DateTime         @updatedAt @map("updated_at")
  posts             BlogPost[]
  ai_blog_cron_jobs AiBlogCronJob[]

  @@map("blog_personas")
}

model BlogCategory {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @unique
  slug       String     @unique
  created_at DateTime   @default(now()) @map("created_at")
  updated_at DateTime   @updatedAt @map("updated_at")
  posts      BlogPost[]

  @@map("blog_categories")
}

model BlogTag {
  id         String        @id @default(uuid()) @db.Uuid
  name       String        @unique
  slug       String        @unique
  created_at DateTime      @default(now()) @map("created_at")
  updated_at DateTime      @updatedAt @map("updated_at")
  posts      BlogPostTag[]

  @@map("blog_tags")
}

model BlogPostTag {
  post_id String   @map("post_id") @db.Uuid
  tag_id  String   @map("tag_id") @db.Uuid
  post    BlogPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  tag     BlogTag  @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([post_id, tag_id])
  @@map("blog_post_tags")
}

model Suggestions {
  id                   String                 @id @default(uuid()) @db.Uuid
  embeddings           Unsupported("vector")? @map("embeddings")
  parameters           Json                   @map("parameters")
  created_at           DateTime               @default(now()) @map("created_at")
  updated_at           DateTime               @updatedAt @map("updated_at")
  plans                Plans[]
  suggestion_languages Suggestion_languages[]

  @@map("suggestions")
}

model Suggestion_languages {
  id            String      @id @default(uuid()) @db.Uuid
  language      String
  content       Json        @map("content")
  suggestion_id String      @map("suggestion_id") @db.Uuid
  suggestion    Suggestions @relation(fields: [suggestion_id], references: [id], onDelete: Cascade)

  @@unique([suggestion_id, language])
  @@map("suggestion_languages")
}

model Plans {
  id                    String               @id @default(uuid()) @db.Uuid
  user_id               String               @map("user_id") @db.Uuid
  user                  Users                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  suggestion_id         String?              @map("suggestion_id") @db.Uuid
  suggestion            Suggestions?         @relation(fields: [suggestion_id], references: [id], onDelete: SetNull)
  country_id            String?              @map("country_id") @db.Uuid
  country               Country?             @relation(fields: [country_id], references: [id], onDelete: SetNull)
  /// Stable step keys the user has ticked. The step *text* is not copied here:
  /// it lives in `visa_steps`, one row per language, and is resolved on read
  /// from `selected_visa_type_id` + the requested locale. Storing only the
  /// identity is what makes switching language keep the progress.
  completed_step_keys   String[]             @default([]) @map("completed_step_keys")
  documents             Json                 @default("[]") @map("documents")
  selected_suggestion   Json?                @map("selected_suggestion")
  status                String               @default("draft") @map("status")
  name                  String?              @map("name")
  notes                 String?              @map("notes")
  created_at            DateTime             @default(now()) @map("created_at")
  updated_at            DateTime             @updatedAt @map("updated_at")
  progress              Float                @default(0) @map("progress")
  description           String?              @map("description")
  selected_visa_type_id String?              @map("selected_visa_type_id") @db.Uuid
  selected_visa_type    ImmigrationVisaType? @relation(fields: [selected_visa_type_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
  @@index([country_id])
  @@map("plans")
}

enum NotificationStatus {
  pending
  delivered
  failed
}

model Events {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  user      Users              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String?
  message   String?
  payload   Json?
  status    NotificationStatus @default(pending)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("events")
}

model VisaTypeRecommendations {
  id              String                 @id @default(uuid()) @db.Uuid
  country_id      String                 @map("country_id") @db.Uuid
  country         Country                @relation(fields: [country_id], references: [id], onDelete: Cascade)
  gemini_response Json                   @map("gemini_response")
  embeddings      Unsupported("vector")? @map("embeddings")
  parameters      Json                   @map("parameters")
  created_at      DateTime               @default(now()) @map("created_at")
  updated_at      DateTime               @updatedAt @map("updated_at")
  language        String

  @@index([country_id])
  @@map("visa_type_recommendations")
}

model VisaSteps {
  id           String              @id @default(uuid()) @db.Uuid
  language     String
  steps        Json                @default("[]")
  visa_type_id String              @map("visa_type_id") @db.Uuid
  visa_type    ImmigrationVisaType @relation(fields: [visa_type_id], references: [id], onDelete: Cascade)
  created_at   DateTime            @default(now()) @map("created_at")
  updated_at   DateTime            @updatedAt @map("updated_at")

  @@unique([visa_type_id, language])
  @@map("visa_steps")
}

model AiBlogCronJob {
  id                  String       @id @default(uuid()) @db.Uuid
  country_id          String       @map("country_id") @db.Uuid
  country             Country      @relation(fields: [country_id], references: [id], onDelete: Cascade)
  category_id         String       @map("category_id") @db.Uuid
  cron_expr           String       @map("cron_expr")
  is_active           Boolean      @default(true) @map("is_active")
  last_run_at         DateTime?    @map("last_run_at")
  bullmq_job_id       String?      @map("bullmq_job_id")
  author_id           String?      @map("author_id") @db.Uuid
  display_author_id   String?      @map("display_author_id") @db.Uuid
  display_author      BlogAuthor?  @relation(fields: [display_author_id], references: [id], onDelete: SetNull)
  persona_id          String?      @map("persona_id") @db.Uuid
  persona             BlogPersona? @relation(fields: [persona_id], references: [id], onDelete: SetNull)
  generate_both_sides Boolean      @default(false) @map("generate_both_sides")
  complexity          String       @default("SIMPLE") @map("complexity")
  political_tone      String       @default("NEUTRAL") @map("political_tone")
  custom_instructions String?      @map("custom_instructions") @db.Text
  created_at          DateTime     @default(now()) @map("created_at")
  updated_at          DateTime     @updatedAt @map("updated_at")

  @@index([country_id])
  @@map("ai_blog_cron_jobs")
}

model UserProfessionalProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  user              Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle          String?  @map("job_title")
  company           String?
  linkedinUrl       String?  @map("linkedin_url")
  githubUrl         String?  @map("github_url")
  websiteUrl        String?  @map("website_url")
  bio               String?  @db.Text
  skills            String[]
  yearsOfExperience Int?     @map("years_of_experience")
  location          String?
  isPublic          Boolean  @default(true) @map("is_public")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("user_professional_profiles")
}

model AiGeneratedImage {
  id           String   @id @default(uuid()) @db.Uuid
  prompt       String   @db.Text
  folder       String
  key          String?
  url          String?
  mimeType     String?  @map("mime_type")
  isPublic     Boolean  @default(true) @map("is_public")
  status       String   @default("pending")
  errorMessage String?  @map("error_message") @db.Text
  userId       String   @map("user_id") @db.Uuid
  user         Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("ai_generated_images")
}

enum BusinessType {
  RESTAURANT
  LEGAL
  TOUR_GUIDE
  GENERAL
}

model Business {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  user         Users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessType BusinessType @map("business_type")
  name         String       @db.VarChar(100)
  description  String?      @db.Text
  address      String?      @db.VarChar(200)
  city         String       @db.VarChar(100)
  country      String?      @db.VarChar(100)
  state        String?      @db.VarChar(120)
  lat          Float?
  lng          Float?
  phone        String?      @db.VarChar(20)
  email        String?      @db.VarChar(100)
  website      String?      @db.VarChar(200)
  photos       String[]
  typeData     Json?        @map("type_data")
  draftData    Json?        @map("draft_data")
  isPublic     Boolean      @default(false) @map("is_public")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  businessPage           BusinessPage?
  publisherQualification PublisherQualification?
  tourGuideReviews       TourGuideReview[]

  @@index([userId])
  @@index([businessType, isPublic])
  @@index([city, isPublic])
  @@map("businesses")
}

enum BusinessPageStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  APPROVED_WITH_PENDING
}

model BusinessPage {
  id              String               @id @default(uuid()) @db.Uuid
  businessId      String               @unique @map("business_id") @db.Uuid
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slug            String               @unique @db.VarChar(48)
  businessType    String               @map("business_type") @db.VarChar(50)
  approvedContent Json?                @map("approved_content")
  approvedAt      DateTime?            @map("approved_at")
  approvedById    String?              @map("approved_by") @db.Uuid
  approvedBy      Users?               @relation("ApprovedPages", fields: [approvedById], references: [id], onDelete: SetNull)
  pendingContent  Json?                @map("pending_content")
  submittedAt     DateTime?            @map("submitted_at")
  status          BusinessPageStatus   @default(DRAFT)
  rejectionReason String?              @map("rejection_reason") @db.Text
  rejectedAt      DateTime?            @map("rejected_at")
  rejectedById    String?              @map("rejected_by") @db.Uuid
  rejectedBy      Users?               @relation("RejectedPages", fields: [rejectedById], references: [id], onDelete: SetNull)
  slugLockedAt    DateTime?            @map("slug_locked_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  reviews         BusinessPageReview[]

  @@index([slug])
  @@index([status])
  @@index([businessId])
  @@map("business_pages")
}

model BusinessPageReview {
  id              String       @id @default(uuid()) @db.Uuid
  pageId          String       @map("page_id") @db.Uuid
  page            BusinessPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  reviewerId      String?      @map("reviewer_id") @db.Uuid
  reviewer        Users?       @relation("ReviewedPages", fields: [reviewerId], references: [id], onDelete: SetNull)
  action          String       @db.VarChar(20)
  reason          String?      @db.Text
  contentSnapshot Json?        @map("content_snapshot")
  reviewedAt      DateTime     @default(now()) @map("reviewed_at")

  @@index([pageId])
  @@map("business_page_reviews")
}

model PublisherQualification {
  businessId             String    @id @map("business_id") @db.Uuid
  business               Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  isQualified            Boolean   @default(false) @map("is_qualified")
  qualifiedAt            DateTime? @map("qualified_at")
  totalApprovals         Int       @default(0) @map("total_approvals")
  lastRejectionAt        DateTime? @map("last_rejection_at")
  disqualifiedAt         DateTime? @map("disqualified_at")
  disqualificationReason String?   @map("disqualification_reason") @db.Text

  // Manual override by admin
  overrideActive Boolean   @default(false) @map("override_active")
  overrideValue  Boolean?  @map("override_value")
  overrideById   String?   @map("override_by") @db.Uuid
  overrideBy     Users?    @relation("PublisherOverrides", fields: [overrideById], references: [id], onDelete: SetNull)
  overrideReason String?   @map("override_reason") @db.Text
  overrideAt     DateTime? @map("override_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("publisher_qualifications")
}

model TourGuideReview {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id") @db.Uuid
  user       Users    @relation(fields: [userId], references: [id])
  rating     Int
  comment    String?  @db.Text
  authorName String   @map("author_name") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([businessId, userId])
  @@map("tour_guide_reviews")
}

/// Which model answers each kind of AI request, and what to fall back to.
///
/// Lives in the database rather than in env vars so switching model is a row
/// update instead of a deploy — the model market moves faster than this app
/// ships. `fallback_models` is ordered; an entry prefixed `gemini-direct:` is
/// served by the Gemini API instead of OpenRouter, which is what keeps a chain
/// working when OpenRouter credits run out.
model AiModelConfig {
  id             String   @id @default(uuid()) @db.Uuid
  scenario       String   @unique
  primaryModel   String   @map("primary_model")
  fallbackModels String[] @map("fallback_models")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("ai_model_configs")
}

/// One row per model call, for auditing spend.
///
/// Exists from day one because image generation dominates the cost of a post and
/// the cron can generate in a loop — without this there is no way to tell a
/// surprise bill apart from normal usage. `cost_usd` is only filled when the
/// provider reports it; an estimate here would be worse than a null.
model AiUsageLog {
  id           String   @id @default(uuid()) @db.Uuid
  scenario     String
  model        String
  provider     String
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  costUsd      Decimal? @map("cost_usd") @db.Decimal(10, 6)
  /// What the call was for, e.g. "blog_post" + the post id. Nullable because a
  /// retry may run before the entity exists.
  entityType   String?  @map("entity_type")
  entityId     String?  @map("entity_id") @db.Uuid
  /// Set when the call failed, so the log shows attempts and not just successes.
  errorKind    String?  @map("error_kind")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([scenario, createdAt])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

/// Categoria turística de um lugar. Cada uma é uma "coisa que se faz num dia de
/// turismo" e precisa ser distinguível como pin no mapa — daí serem oito, e não
/// uma taxonomia exaustiva.
enum PlaceCategory {
  LANDMARK
  MUSEUM
  NATURE
  BEACH
  VIEWPOINT
  FOOD_MARKET
  NIGHTLIFE
  NEIGHBORHOOD
}

/// Ponto turístico de uma cidade.
///
/// `countryCode` (ISO2) é a chave de busca, não `countryId`: o seletor do
/// frontend trabalha com ISO2 vindo do CountriesNow, e `Country` não tem esse
/// campo — só `name`. O FK existe para ligar o lugar ao destino de imigração
/// quando o país estiver cadastrado, e é opcional justamente porque nem todo
/// país com lugar precisa ser um destino.
///
/// `city` é string livre pelo mesmo motivo que em `Business`: não existe model
/// City. O valor precisa ser exatamente o que o CountriesNow devolve ("Lisbon",
/// não "Lisboa"), senão a cidade selecionada nunca casa com os lugares.
model Place {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(120)
  slug            String        @db.VarChar(140)
  category        PlaceCategory
  countryCode     String        @map("country_code") @db.VarChar(2)
  countryId       String?       @map("country_id") @db.Uuid
  country         Country?      @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city            String        @db.VarChar(100)
  lat             Float
  lng             Float
  imageUrl        String?       @map("image_url") @db.VarChar(300)
  popularityScore Int           @default(0) @map("popularity_score")
  isFree          Boolean       @default(false) @map("is_free")
  address         String?       @db.VarChar(200)
  website         String?       @db.VarChar(200)
  sourceUrl       String?       @map("source_url") @db.VarChar(300)
  isActive        Boolean       @default(true) @map("is_active")

  /// Onde o lugar está no ciclo de revisão.
  ///
  /// O default é APPROVED porque os 30 lugares que já existem foram curados à
  /// mão e estão no ar — esse é o estado verdadeiro deles, e assim a migration
  /// não precisa de backfill. A ingestão automática sempre grava DRAFT
  /// explicitamente.
  ///
  /// REJECTED não é lixo: a linha fica como memória, para a re-ingestão da
  /// cidade não recriar um lugar que alguém já recusou.
  reviewStatus PlaceReviewStatus @default(APPROVED) @map("review_status")
  ingestionId  String?           @map("ingestion_id") @db.Uuid
  ingestion    CityIngestion?    @relation(fields: [ingestionId], references: [id], onDelete: SetNull)

  /// Proveniência. Serve à atribuição exigida pela ODbL, e a saber de onde veio
  /// cada campo quando alguém questionar o dado.
  osmType               String?  @map("osm_type") @db.VarChar(10)
  osmId                 BigInt?  @map("osm_id")
  wikidataId            String?  @map("wikidata_id") @db.VarChar(20)
  /// Média mensal de visitas ao artigo em inglês, de 12 meses. É de onde o
  /// `popularityScore` é derivado — guardado cru para a ordem ser auditável.
  wikipediaMonthlyViews Int?     @map("wikipedia_monthly_views")
  generatedByModel      String?  @map("generated_by_model")
  generationCostUsd     Decimal? @map("generation_cost_usd") @db.Decimal(10, 6)

  translations PlaceTranslation[]
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@unique([countryCode, city, slug])
  @@index([countryCode, city, isActive])
  @@index([ingestionId, reviewStatus])
  @@map("places")
}

/// Só `description` e `tip` são traduzidos. `name` fica no idioma local de
/// propósito: "Torre de Belém" é o que está na placa e no mapa — traduzir
/// atrapalharia quem procura o lugar na rua.
model PlaceTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  language    String
  description String
  tip         String?
  place       Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId     String  @map("place_id") @db.Uuid

  @@unique([placeId, language])
  @@map("place_translations")
}

enum PlaceReviewStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum CityIngestionStatus {
  PROCESSING
  FAILED
  READY_FOR_REVIEW
  APPROVED
  REJECTED
}

/// Uma tentativa de popular os lugares de uma cidade.
///
/// A revisão é por CIDADE, não por lugar: com ~186 cidades e ~10 lugares cada,
/// aprovar um por um seriam 1.800 decisões, e trabalho que ninguém faz vira
/// conteúdo que nunca sai do rascunho. O admin olha os ~10 lugares de uma
/// cidade numa tela e decide de uma vez — podendo rejeitar ou editar lugares
/// individuais dentro dela.
///
/// Não existe um model "PlaceCandidate" separado de propósito: o `Place` em
/// DRAFT já é o candidato, e um segundo model seria código morto.
model CityIngestion {
  id           String              @id @default(uuid()) @db.Uuid
  countryCode  String              @map("country_code") @db.VarChar(2)
  city         String              @db.VarChar(100)
  status       CityIngestionStatus @default(PROCESSING)
  /// Em que etapa está, ou em qual falhou: resolve_area | fetch_pois | rank |
  /// write_texts. Sem isto, uma ingestão FAILED não diz o que tentar de novo.
  step         String?             @db.VarChar(30)
  errorMessage String?             @map("error_message")

  /// Resultado da resolução de área no OSM, guardado para o retry não repetir a
  /// consulta — e porque o nome que o OSM usa ("Lisboa") não é o que a nossa
  /// lista de cidades usa ("Lisbon").
  osmAreaId      BigInt? @map("osm_area_id")
  osmMatchedName String? @map("osm_matched_name") @db.VarChar(120)

  /// Contadores da execução: quantos elementos vieram, quantos tinham wikidata,
  /// quantos tinham artigo em inglês, quantos ficaram, e a lista de conflitos
  /// com lugares já curados. Essa lista é a métrica de redescoberta do piloto.
  stats Json?

  requestedById   String?   @map("requested_by_id") @db.Uuid
  approvedAt      DateTime? @map("approved_at")
  approvedById    String?   @map("approved_by_id") @db.Uuid
  rejectedAt      DateTime? @map("rejected_at")
  rejectedById    String?   @map("rejected_by_id") @db.Uuid
  rejectionReason String?   @map("rejection_reason")

  places    Place[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([countryCode, city])
  @@index([status, createdAt])
  @@map("city_ingestions")
}
